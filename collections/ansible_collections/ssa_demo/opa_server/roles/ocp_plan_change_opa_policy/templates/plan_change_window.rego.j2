package policies

import rego.v1

# Define plan change window in UTC (Templated via Ansible or hardcoded)
plan_change_start := "{{ plan_change_start }}"  # UTC
plan_change_end := "{{ plan_change_end }}"      # UTC

# Default response when outside the change window
default plan_change_window := {
    "allowed": true,
    "violations": [],
}

# Check if the job was created within the plan change window (UTC)
is_plan_change_time if {
    # Guard check: Only proceed if input.created exists in the AAP payload
    input.created

    # Parse timestamps INSIDE the rule body
    created_clock := time.parse_rfc3339_ns(input.created)
    change_start := time.parse_rfc3339_ns(plan_change_start)
    change_end := time.parse_rfc3339_ns(plan_change_end)

    print("created_clock: ", created_clock)
    print("change_start:  ", change_start)
    print("change_end:    ", change_end)

    created_clock >= change_start
    created_clock <= change_end 
}

# Block execution during the change window
plan_change_window := {
    "allowed": false,
    "violations": [
        sprintf("No job execution allowed during plan change window (%s to %s)", [plan_change_start, plan_change_end])
    ],
} if {
    is_plan_change_time
}